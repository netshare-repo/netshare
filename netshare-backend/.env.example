# NetShare Backend Environment Configuration
# Copy to .env and fill in actual values

# Server
NODE_ENV=development
PORT=8000

# MongoDB
MONGO_URI=mongodb://localhost:27017/netshare_db

# Authentication
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d

# Temporary local signup bypass only. Never enabled outside NODE_ENV=development.
# Password-reset OTP is unaffected. Leave false in shared/production environments.
DEV_SKIP_OTP_VERIFICATION=false

# CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SMTP (required in production for OTP email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@netshare.io

# Optional SMS verification: real provider required; no mock production fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Redis (BullMQ task queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ML Service
ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=750

# Logging
LOG_LEVEL=debug

# Phase 11A backend foundation; keep disabled until Android execution is implemented and reviewed.
PUBLIC_DATA_FETCH_ENABLED=false
BROWSER_PAGE_INSPECT_ENABLED=false
REGIONAL_UPTIME_MONITOR_ENABLED=false
REGIONAL_UPTIME_MONITOR_SCHEDULER_INTERVAL_MS=15000

# Phase 12C private browser screenshot artifacts. Local storage is development-only.
# Production defaults to an unavailable external adapter until one is explicitly configured.
SCREENSHOT_STORAGE_PROVIDER=local
SCREENSHOT_STORAGE_LOCAL_DIR=./private/screenshot-artifacts
SCREENSHOT_ARTIFACT_MAX_BYTES=2097152
SCREENSHOT_UPLOAD_GRANT_TTL_MS=300000
SCREENSHOT_ARTIFACT_RETENTION_MS=86400000
SCREENSHOT_CLEANUP_INTERVAL_MS=900000
SCREENSHOT_ORPHAN_GRACE_MS=900000
SCREENSHOT_ABANDONED_UPLOAD_MS=600000
