{
  "name": "netshare-root",
  "version": "1.0.0",
  "private": true,
  "description": "NetShare root workspace scripts",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix netshare-backend run dev",
    "dev:frontend": "npm --prefix netshare-frontend run dev",
    "start:backend": "npm --prefix netshare-backend start",
    "build:frontend": "npm --prefix netshare-frontend run build",
    "test:distributed": "node tests/distributedSystemTest.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
